# ==============================================================================
# Android & Jetpack Compose .gitignore
# ==============================================================================

# Built application files & packages
*.apk
*.aar
*.ap_
*.aab
*.dex
*.class

# Build directories & generated files
build
UI designs


# Gradle files & caches
.gradle/
.gradletasknamecache
gradle/gradle-daemon-jvm.properties

# Local configuration files
local.properties
.DO_NOT_SYNC

# Proguard / R8
proguard/
app/proguard-rules.pro.bak

# Android Studio & IntelliJ IDEA
*.iml
*.ipr
*.iws
.idea/caches/
.idea/libraries/
.idea/modules.xml
.idea/workspace.xml
.idea/navEditor.xml
.idea/assetWizardSettings.xml
.idea/deploymentTargetSelector.xml
.idea/deviceManager.xml
.idea/shelf/
.idea/appInsightsSettings.xml

# Captures and profiling
captures/
.navigation/

# Native builds
.externalNativeBuild/
.cxx/

# Keystores & signing secrets
*.jks
*.keystore
release-keystore.jks

# Secrets & environment configurations
.env
.env.*
secrets.properties
serviceAccountKey.json
firebase_setup

# Firebase configuration (uncomment if keeping private)
# app/google-services.json

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs & temp test captures
*.log
emulator_*.png
